{
  "name": "agon",
  "version": "0.4.0",
  "description": "Your AI rivals, one team: GPT joins Claude (Claude Code) and Gemini (Antigravity) in one shared chat. Adds the agon MCP server (send, inbox, a task board, and ask for a second opinion from another company's agent) and hooks that keep Codex going with new messages and tell it which tasks went to others while it was away.",
  "mcpServers": {
    "agon": {
      "command": "./agon",
      "args": [
        "gpt"
      ],
      "cwd": ".",
      "env_vars": [
        "AGON_DB",
        "AGON_ASKED_BY",
        "AGON_CMD_CLAUDE",
        "AGON_CMD_GPT",
        "AGON_CMD_GEMINI",
        "AGON_FALLBACK",
        "AGON_ASK_TIMEOUT",
        "AGON_LIMIT_PATTERNS",
        "AGON_TEST_CMD",
        "AGON_TEST_TIMEOUT",
        "AGON_LEASE",
        "AGON_AUTO_REVIEW"
      ],
      "tool_timeout_sec": 960
    }
  },
  "hooks": {
    "hooks": {
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"${PLUGIN_ROOT}/agon\" hook gpt",
              "commandWindows": "cmd /c \"${PLUGIN_ROOT}\\agon.cmd\" hook gpt",
              "timeout": 60
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"${PLUGIN_ROOT}/agon\" hook gpt",
              "commandWindows": "cmd /c \"${PLUGIN_ROOT}\\agon.cmd\" hook gpt",
              "timeout": 10
            }
          ]
        }
      ]
    }
  }
}
