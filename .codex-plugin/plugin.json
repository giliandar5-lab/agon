{
  "name": "agon",
  "version": "0.2.0",
  "description": "Your AI rivals, one team: GPT joins Claude (Claude Code) and Gemini (Antigravity) in one shared chat. Adds the agon MCP server (send, inbox) and a Stop hook that keeps Codex going with new messages.",
  "mcpServers": {
    "agon": {
      "command": "./agon",
      "args": [
        "gpt"
      ],
      "cwd": ".",
      "env_vars": [
        "AGON_DB"
      ]
    }
  },
  "hooks": {
    "hooks": {
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"${PLUGIN_ROOT}/agon\" hook gpt",
              "commandWindows": "cmd /c \"${PLUGIN_ROOT}\\agon.cmd\" hook gpt",
              "timeout": 60
            }
          ]
        }
      ]
    }
  }
}
